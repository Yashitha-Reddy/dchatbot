# Copy to .env; process environment takes precedence.
LLM_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# Required for the default NVIDIA hosted provider. Set your key privately.
NVIDIA_API_KEY=
# Empty generates once and persists in data/chat_api_key.
CHAT_API_KEY=
CHAT_MAX_CONCURRENT=2
# Optional PostgreSQL with PostGIS; embeddings stay in the local vector index.
DATABASE_URL=
GEO_SOURCE_SRID=4326
